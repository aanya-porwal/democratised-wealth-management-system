# ─────────────────────────────────────────────────────────────────────
# Wealth Management System — environment configuration
#
# Copy this file to `.env` and adjust for your environment:
#   cp .env.example .env
#
# Never commit a real `.env`. Docker Compose loads it automatically.
# ─────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development            # development | testing | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated list of allowed host names (TrustedHostMiddleware).
ALLOWED_HOSTS=localhost,127.0.0.1,test,testserver

# ── Security ────────────────────────────────────────────────────────
# REQUIRED: generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080      # 7 days
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
BCRYPT_ROUNDS=12

# ── Database ────────────────────────────────────────────────────────
# Local Postgres (docker compose) — the backend uses the service name
# `postgres` inside the compose network, `localhost` for host runs.
DATABASE_URL=postgresql+psycopg2://wealth:wealth@localhost:5432/wealth_db
# Testing database (used by the pytest suite).
# TEST_DATABASE_URL=postgresql+psycopg2://wealth:wealth@localhost:5432/wealth_test
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400

# ── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false                          # true in production

# ── Background tasks ────────────────────────────────────────────────
SCHEDULER_ENABLED=true
MARKET_DATA_REFRESH_HOURS=6
SNAPSHOT_GENERATION_HOURS=24

